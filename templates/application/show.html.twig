
{% extends 'base.html.twig' %}

{% block title %}{{ application.name }} — DeployTrack{% endblock %}
{% block breadcrumb %}{{ application.name }}{% endblock %}

{% block body %}
<div class=" space-y-6">

    {# Navigation et en-tête #}
    <div>
        <a
            href="{{ path('app_application_index') }}"
            class="inline-flex items-center gap-2 text-sm text-gray-500 transition hover:text-gray-950"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                <path d="m15 18-6-6 6-6"/>
                <path d="M9 12h11"/>
            </svg>
            Retour aux applications
        </a>

        <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex min-w-0 items-center gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-xl font-semibold uppercase text-gray-700">
                    {{ application.name|slice(0, 1) }}
                </div>

                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="break-words text-2xl font-semibold tracking-tight text-gray-950">
                            {{ application.name }}
                        </h1>

                        <span class="inline-flex items-center rounded-md border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600">
                            Application
                        </span>
                    </div>

                    <p class="mt-1.5 text-sm text-gray-500">
                        Identifiant #{{ application.id }}
                        <span class="mx-1.5 text-gray-300">·</span>
                        Créée le {{ application.createdAt|date('d/m/Y') }}
                    </p>
                </div>
            </div>

            <div class="flex shrink-0 items-center gap-2">
                <a
                    href="{{ path('app_application_edit', {id: application.id}) }}"
                    class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-3.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50 hover:text-gray-950"
                >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" class="h-4 w-4" aria-hidden="true">
                        <path d="m14 6 4 4M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16l-1 4Z"/>
                    </svg>
                    Modifier
                </a>

                <a
                    href="{{ path('app_application_index') }}"
                    class="inline-flex h-10 items-center justify-center rounded-lg bg-gray-950 px-4 text-sm font-medium text-white transition hover:bg-gray-800"
                >
                    Toutes les applications
                </a>
            </div>
        </div>
    </div>

    {# Résumé des informations #}
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3">

        <div class="rounded-xl border border-gray-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-gray-500">Identifiant</p>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" class="h-4 w-4 text-gray-400" aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="3"/>
                    <path d="M8 9h8M8 13h5"/>
                </svg>
            </div>
            <p class="mt-3 font-mono text-2xl font-semibold tracking-tight text-gray-950">
                #{{ application.id }}
            </p>
            <p class="mt-1 text-xs text-gray-500">Référence de l'application</p>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-gray-500">Dépôt Git</p>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" class="h-4 w-4 text-gray-400" aria-hidden="true">
                    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19.05 4.7 5.07 5.07 0 0 0 18.96 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.04 1 4.04 1a5.07 5.07 0 0 0-.09 3.7A5.44 5.44 0 0 0 2.5 8.52c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22"/>
                </svg>
            </div>
            <p class="mt-3 text-xl font-semibold tracking-tight text-gray-950">
                {{ application.repositoryUrl ? 'Connecté' : 'Non renseigné' }}
            </p>
            <p class="mt-1 text-xs text-gray-500">
                {% if application.repositoryUrl %}
                    URL du dépôt enregistrée
                {% else %}
                    Aucun dépôt associé pour le moment
                {% endif %}
            </p>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-gray-500">Date de création</p>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" class="h-4 w-4 text-gray-400" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                    <path d="M16 3v4M8 3v4M3 10h18"/>
                </svg>
            </div>
            <p class="mt-3 text-xl font-semibold tracking-tight text-gray-950">
                {{ application.createdAt|date('d/m/Y') }}
            </p>
            <p class="mt-1 text-xs text-gray-500">
                À {{ application.createdAt|date('H:i') }}
            </p>
        </div>
    </section>

    {# Contenu principal #}
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">

        <div class="space-y-6">

            {# Dépôt Git #}
            <section class="overflow-hidden rounded-xl border border-gray-200 bg-white">
                <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
                    <div>
                        <h2 class="text-sm font-semibold text-gray-950">Dépôt Git</h2>
                        <p class="mt-1 text-xs text-gray-500">
                            Code source associé à cette application.
                        </p>
                    </div>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" class="h-5 w-5 text-gray-400" aria-hidden="true">
                        <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19.05 4.7 5.07 5.07 0 0 0 18.96 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.04 1 4.04 1a5.07 5.07 0 0 0-.09 3.7A5.44 5.44 0 0 0 2.5 8.52c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22"/>
                    </svg>
                </div>

                <div class="p-5">
                    {% if application.repositoryUrl %}
                        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                            <div class="flex min-w-0 items-start gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-gray-700">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.7" class="h-5 w-5" aria-hidden="true">
                                        <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19.05 4.7 5.07 5.07 0 0 0 18.96 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.04 1 4.04 1a5.07 5.07 0 0 0-.09 3.7A5.44 5.44 0 0 0 2.5 8.52c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22"/>
                                    </svg>
                                </div>

                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-gray-900">Dépôt source</p>
                                    <a
                                        href="{{ application.repositoryUrl }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mt-1 block break-all text-sm text-gray-500 underline decoration-gray-300 underline-offset-4 transition hover:text-gray-950"
                                    >
                                        {{ application.repositoryUrl }}
                                    </a>
                                </div>
                            </div>

                            <a
                                href="{{ application.repositoryUrl }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-lg border border-gray-200 px-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50 hover:text-gray-950"
                            >
                                Ouvrir le dépôt
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.7" class="h-3.5 w-3.5" aria-hidden="true">
                                    <path d="M14 4h6v6M20 4l-9 9"/>
                                    <path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/>
                                </svg>
                            </a>
                        </div>
                    {% else %}
                        <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50/70 px-5 py-8 text-center">
                            <p class="text-sm font-medium text-gray-800">
                                Aucun dépôt Git renseigné
                            </p>
                            <p class="mt-1 text-sm text-gray-500">
                                Ajoutez l'URL du dépôt pour la retrouver facilement.
                            </p>
                            <a
                                href="{{ path('app_application_edit', {id: application.id}) }}"
                                class="mt-4 inline-flex h-9 items-center justify-center rounded-lg border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50"
                            >
                                Ajouter un dépôt
                            </a>
                        </div>
                    {% endif %}
                </div>
            </section>

            {# Description #}
            <section class="overflow-hidden rounded-xl border border-gray-200 bg-white">
                <div class="border-b border-gray-200 px-5 py-4">
                    <h2 class="text-sm font-semibold text-gray-950">Description</h2>
                    <p class="mt-1 text-xs text-gray-500">
                        Présentation générale du projet.
                    </p>
                </div>

                <div class="p-5">
                    {% if application.description %}
                        <p class="whitespace-pre-line break-words text-sm leading-7 text-gray-700">{{ application.description }}</p>
                    {% else %}
                        <p class="text-sm leading-6 text-gray-500">
                            Aucune description n'a été ajoutée à cette application.
                        </p>
                        <a
                            href="{{ path('app_application_edit', {id: application.id}) }}"
                            class="mt-3 inline-flex text-sm font-medium text-gray-800 underline decoration-gray-300 underline-offset-4 hover:text-black"
                        >
                            Ajouter une description
                        </a>
                    {% endif %}
                </div>
            </section>
        </div>

        {# Panneau latéral #}
        <aside class="space-y-4">

            <section class="rounded-xl border border-gray-200 bg-white p-5">
                <h2 class="text-sm font-semibold text-gray-950">
                    Informations
                </h2>

                <dl class="mt-4 space-y-4">
                    <div>
                        <dt class="text-xs text-gray-500">Nom</dt>
                        <dd class="mt-1 break-words text-sm font-medium text-gray-900">
                            {{ application.name }}
                        </dd>
                    </div>

                    <div>
                        <dt class="text-xs text-gray-500">Identifiant interne</dt>
                        <dd class="mt-1 font-mono text-sm text-gray-900">
                            #{{ application.id }}
                        </dd>
                    </div>

                    <div>
                        <dt class="text-xs text-gray-500">Création</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {{ application.createdAt|date('d/m/Y à H:i') }}
                        </dd>
                    </div>

                    <div>
                        <dt class="text-xs text-gray-500">Dépôt Git</dt>
                        <dd class="mt-1 flex items-center gap-2 text-sm text-gray-800">
                            <span class="h-2 w-2 rounded-full {{ application.repositoryUrl ? 'bg-gray-900' : 'bg-gray-300' }}"></span>
                            {{ application.repositoryUrl ? 'Renseigné' : 'Non renseigné' }}
                        </dd>
                    </div>
                </dl>

                <a
                    href="{{ path('app_application_edit', {id: application.id}) }}"
                    class="mt-5 inline-flex h-10 w-full items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50 hover:text-gray-950"
                >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" class="h-4 w-4" aria-hidden="true">
                        <path d="m14 6 4 4M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16l-1 4Z"/>
                    </svg>
                    Modifier les informations
                </a>
            </section>

            <section class="rounded-xl border border-gray-200 bg-white p-5">
                <h2 class="text-sm font-semibold text-gray-950">
                    Prochaines étapes
                </h2>
                <p class="mt-2 text-sm leading-6 text-gray-500">
                    Les environnements, releases et déploiements pourront être suivis ici
                    à mesure que ces fonctionnalités seront intégrées.
                </p>
            </section>
        </aside>
    </div>
</div>
{% endblock %}
