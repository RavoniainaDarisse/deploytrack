
{% extends 'base.html.twig' %}

{% block title %}Applications — DeployTrack{% endblock %}

{% block body %}
    <main style="max-width: 1100px; margin: 40px auto; padding: 0 20px;">
        <header style="display: flex; justify-content: space-between; align-items: center; gap: 16px;">
            <div>
                <h1>Applications</h1>
                <p>Gérez les applications suivies dans DeployTrack.</p>
            </div>

            <a href="#" aria-disabled="true">
                Nouvelle application
            </a>
        </header>

        {% if applications is empty %}
            <section style="margin-top: 32px; padding: 24px; border: 1px solid #ddd; border-radius: 8px;">
                <h2>Aucune application</h2>
                <p>Vous n'avez pas encore enregistré d'application.</p>
            </section>
        {% else %}
            <table style="width: 100%; margin-top: 32px; border-collapse: collapse;">
                <thead>
                    <tr style="text-align: left; border-bottom: 1px solid #ddd;">
                        <th style="padding: 12px;">Nom</th>
                        <th style="padding: 12px;">Dépôt Git</th>
                        <th style="padding: 12px;">Créée le</th>
                    </tr>
                </thead>
               
                <tbody>
                    {% for application in applications %}
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 12px;">
                                {{ application.name }}
                            </td>

                            <td style="padding: 12px;">
                                {% if application.repositoryUrl %}
                                    <a href="{{ application.repositoryUrl }}"
                                    target="_blank"
                                    rel="noopener noreferrer">
                                        Voir le dépôt
                                    </a>
                                {% else %}
                                    —
                                {% endif %}
                            </td>

                            <td style="padding: 12px;">
                                {{ application.createdAt|date('d/m/Y H:i') }}
                            </td>

                            <td style="padding: 12px;">
                                <a href="{{ path('app_application_show', {
                                    id: application.id
                                }) }}">
                                    Voir les détails
                                </a>

                                <form
                                    method="post"
                                    action="{{ path('app_application_delete', {
                                        id: application.id
                                    }) }}"
                                    onsubmit="return confirm('Voulez-vous vraiment supprimer cette application ?');"
                                    style="display: inline-block; margin-left: 10px;"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('delete_application_' ~ application.id) }}"
                                    >

                                    <button type="submit">
                                        Supprimer
                                    </button>
                                </form>

                                <a href="{{ path('app_application_edit', {
                                    id: application.id
                                }) }}">
                                    Modifier l'application
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" style="padding: 20px; text-align: center;">
                                Aucune application enregistrée.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>

            </table>
        {% endif %}
    </main>
{% endblock %}
