
{% extends 'base.html.twig' %}

{% block title %}Applications — DeployTrack{% endblock %}
{% block breadcrumb %}Applications{% endblock %}

{% block body %}
<div class="space-y-6">

    {# En-tête de page #}
    <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-gray-950">
                Applications
            </h1>
            <p class="mt-1.5 text-sm text-gray-500">
                Gérez vos applications et suivez leur cycle de déploiement.
            </p>
        </div>

        <a
            href="{{ path('app_application_new') }}"
            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-gray-950 px-4 text-sm font-medium text-white transition hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Nouvelle application
        </a>
    </section>

    {# Indicateurs compacts #}
    <section class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="flex items-center gap-4 rounded-lg border border-gray-200 bg-white px-5 py-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100 text-gray-700">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" class="h-5 w-5" aria-hidden="true">
                    <rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/>
                    <rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/>
                    <rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/>
                    <rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>
                </svg>
            </div>
            <div>
                <p class="text-sm text-gray-500">Applications suivies</p>
                <p class="mt-0.5 text-xl font-semibold tracking-tight text-gray-950">
                    {{ applications|length }}
                </p>
            </div>
        </div>

        <div class="flex items-center gap-4 rounded-lg border border-gray-200 bg-white px-5 py-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100 text-gray-700">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" class="h-5 w-5" aria-hidden="true">
                    <path d="M8 19c-4 1.3-4-2.5-5.5-3M14.5 22v-3.2a3 3 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.5a5 5 0 0 0-1.3-3.4 4.7 4.7 0 0 0-.1-3.5s-1.2-.4-3.8 1.5a12 12 0 0 0-6.5 0C5.4.6 4.2 1 4.2 1a4.7 4.7 0 0 0-.1 3.5A5 5 0 0 0 2.8 8c0 5 3 6.2 6 6.5a3 3 0 0 0-.8 2.3V22"/>
                </svg>
            </div>
            <div>
                <p class="text-sm text-gray-500">Dépôts Git renseignés</p>
                <p class="mt-0.5 text-xl font-semibold tracking-tight text-gray-950">
                    {% set repositoriesCount = 0 %}
                    {% for application in applications %}
                        {% if application.repositoryUrl %}
                            {% set repositoriesCount = repositoriesCount + 1 %}
                        {% endif %}
                    {% endfor %}
                    {{ repositoriesCount }}
                </p>
            </div>
        </div>
    </section>

    {# Liste des applications #}
    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white">

        {# Barre d'outils #}
        <div class="flex flex-col gap-4 border-b border-gray-200 px-5 py-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h2 class="text-sm font-semibold text-gray-950">
                    Toutes les applications
                </h2>
                <p class="mt-1 text-xs text-gray-500">
                    Retrouvez les dépôts et les informations de chaque application.
                </p>
            </div>

            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <label class="relative block">
                    <span class="sr-only">Rechercher une application</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8"
                         class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400"
                         aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/>
                        <path d="m16 16 4 4"/>
                    </svg>
                    <input
                        id="application-search"
                        type="search"
                        placeholder="Rechercher une application..."
                        class="h-10 w-full rounded-lg border border-gray-200 bg-white pl-9 pr-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-400 focus:ring-2 focus:ring-gray-100 sm:w-64"
                    >
                </label>

                <label>
                    <span class="sr-only">Filtrer par dépôt</span>
                    <select
                        id="repository-filter"
                        class="h-10 w-full rounded-lg border border-gray-200 bg-white px-3 text-sm text-gray-700 outline-none focus:border-gray-400 focus:ring-2 focus:ring-gray-100 sm:w-44"
                    >
                        <option value="all">Tous les dépôts</option>
                        <option value="connected">Dépôt renseigné</option>
                        <option value="missing">Sans dépôt</option>
                    </select>
                </label>
            </div>
        </div>

        {% if applications is empty %}
            {# État vide #}
            <div class="px-6 py-16 text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-gray-500">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.6" class="h-6 w-6" aria-hidden="true">
                        <rect x="4" y="4" width="16" height="16" rx="3"/>
                        <path d="M9 9h6M9 13h6"/>
                    </svg>
                </div>

                <h3 class="mt-4 text-sm font-semibold text-gray-950">
                    Aucune application pour le moment
                </h3>
                <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-gray-500">
                    Ajoutez votre première application pour commencer à centraliser
                    ses informations dans DeployTrack.
                </p>
                <a
                    href="{{ path('app_application_new') }}"
                    class="mt-5 inline-flex h-10 items-center justify-center rounded-lg bg-gray-950 px-4 text-sm font-medium text-white transition hover:bg-gray-800"
                >
                    Créer une application
                </a>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[850px] text-left text-sm">
                    <thead class="border-b border-gray-200 bg-gray-50 text-xs font-medium text-gray-500">
                        <tr>
                            <th scope="col" class="px-5 py-3.5 font-medium">Application</th>
                            <th scope="col" class="px-5 py-3.5 font-medium">Dépôt Git</th>
                            <th scope="col" class="px-5 py-3.5 font-medium">Environnements</th>
                            <th scope="col" class="px-5 py-3.5 font-medium">Dernier déploiement</th>
                            <th scope="col" class="px-5 py-3.5 text-right font-medium">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="applications-table" class="divide-y divide-gray-100">
                        {% for application in applications %}
                            <tr
                                class="application-row transition-colors hover:bg-gray-50"
                                data-name="{{ application.name|lower }}"
                                data-repository="{{ application.repositoryUrl ? 'connected' : 'missing' }}"
                            >
                                {# Nom de l'application #}
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-sm font-semibold uppercase text-gray-700">
                                            {{ application.name|slice(0, 1) }}
                                        </div>

                                        <div class="min-w-0">
                                            <a
                                                href="{{ path('app_application_show', {id: application.id}) }}"
                                                class="font-medium text-gray-950 hover:underline"
                                            >
                                                {{ application.name }}
                                            </a>
                                            <p class="mt-1 text-xs text-gray-500">
                                                ID-{{ application.id }}
                                            </p>
                                        </div>
                                    </div>
                                </td>

                                {# Dépôt Git #}
                                <td class="px-5 py-4">
                                    {% if application.repositoryUrl %}
                                        <a
                                            href="{{ application.repositoryUrl }}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            title="{{ application.repositoryUrl }}"
                                            class="inline-flex max-w-64 items-center gap-2 text-gray-700 transition hover:text-black"
                                        >
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.7" class="h-4 w-4 shrink-0"
                                                 aria-hidden="true">
                                                <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19.05 4.7 5.07 5.07 0 0 0 18.96 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.04 1 4.04 1a5.07 5.07 0 0 0-.09 3.7A5.44 5.44 0 0 0 2.5 8.52c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22"/>
                                            </svg>
                                            <span class="truncate font-mono text-xs">
                                                {{ application.repositoryUrl|replace({
                                                    'https://github.com/': '',
                                                    'https://gitlab.com/': ''
                                                }) }}
                                            </span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.7" class="h-3.5 w-3.5 shrink-0 text-gray-400"
                                                 aria-hidden="true">
                                                <path d="M14 4h6v6M20 4l-9 9"/>
                                                <path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/>
                                            </svg>
                                        </a>
                                    {% else %}
                                        <span class="inline-flex items-center gap-2 text-xs text-gray-400">
                                            <span class="h-1.5 w-1.5 rounded-full bg-gray-300"></span>
                                            Non renseigné
                                        </span>
                                    {% endif %}
                                </td>

                                {# Environnements : affichage prudent si la relation existe #}
                                <td class="px-5 py-4">
                                    {% if application.environments is defined and application.environments|length > 0 %}
                                        <span class="inline-flex items-center rounded-md border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-medium text-gray-700">
                                            {{ application.environments|length }}
                                            environnement(s)
                                        </span>
                                    {% else %}
                                        <span class="text-xs text-gray-400">Aucun environnement</span>
                                    {% endif %}
                                </td>

                                {# Aucun déploiement n'est simulé #}
                                <td class="px-5 py-4">
                                    <span class="inline-flex items-center gap-2 text-xs text-gray-500">
                                        <span class="h-1.5 w-1.5 rounded-full bg-gray-300"></span>
                                        Aucun déploiement
                                    </span>
                                </td>

                                {# Actions #}
                                <td class="px-5 py-4">
                                    <div class="flex items-center justify-end gap-1">
                                        <a
                                            href="{{ path('app_application_show', {id: application.id}) }}"
                                            aria-label="Voir {{ application.name }}"
                                            title="Voir les détails"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-gray-500 transition hover:bg-gray-100 hover:text-gray-950"
                                        >
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.7" class="h-4 w-4" aria-hidden="true">
                                                <path d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        </a>

                                        <a
                                            href="{{ path('app_application_edit', {id: application.id}) }}"
                                            aria-label="Modifier {{ application.name }}"
                                            title="Modifier"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-gray-500 transition hover:bg-gray-100 hover:text-gray-950"
                                        >
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.7" class="h-4 w-4" aria-hidden="true">
                                                <path d="m14 6 4 4M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16l-1 4Z"/>
                                            </svg>
                                        </a>

                                        <form
                                            method="post"
                                            action="{{ path('app_application_delete', {id: application.id}) }}"
                                            onsubmit="return confirm('Voulez-vous vraiment supprimer cette application ?');"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete_application_' ~ application.id) }}"
                                            >
                                            <button
                                                type="submit"
                                                aria-label="Supprimer {{ application.name }}"
                                                title="Supprimer"
                                                class="inline-flex h-8 w-8 items-center justify-center rounded-md text-gray-500 transition hover:bg-gray-100 hover:text-red-700"
                                            >
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="1.7" class="h-4 w-4" aria-hidden="true">
                                                    <path d="M4 7h16M10 11v6M14 11v6M5 7l1 14h12l1-14M9 7V4h6v3"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}

                        <tr id="no-search-results" class="hidden">
                            <td colspan="5" class="px-5 py-12 text-center text-sm text-gray-500">
                                Aucun résultat ne correspond à votre recherche.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            {# Pied du tableau #}
            <div class="flex flex-col gap-2 border-t border-gray-200 px-5 py-3.5 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between">
                <p>
                    <span id="visible-count">{{ applications|length }}</span>
                    résultat(s)
                </p>
                <p>Liste des applications enregistrées</p>
            </div>
        {% endif %}
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const search = document.getElementById('application-search');
        const filter = document.getElementById('repository-filter');
        const rows = Array.from(document.querySelectorAll('.application-row'));
        const emptyResult = document.getElementById('no-search-results');
        const visibleCount = document.getElementById('visible-count');

        if (!search || !filter) {
            return;
        }

        function filterApplications() {
            const query = search.value.trim().toLowerCase();
            const repositoryFilter = filter.value;
            let count = 0;

            rows.forEach((row) => {
                const matchesName = row.dataset.name.includes(query);
                const matchesRepository =
                    repositoryFilter === 'all' ||
                    row.dataset.repository === repositoryFilter;

                const visible = matchesName && matchesRepository;
                row.classList.toggle('hidden', !visible);

                if (visible) {
                    count++;
                }
            });

            if (emptyResult) {
                emptyResult.classList.toggle('hidden', count !== 0);
            }

            if (visibleCount) {
                visibleCount.textContent = count;
            }
        }

        search.addEventListener('input', filterApplications);
        filter.addEventListener('change', filterApplications);
    });
</script>
{% endblock %}
