
{% extends 'base.html.twig' %}

{% block title %}Modifier {{ application.name }} — DeployTrack{% endblock %}
{% block breadcrumb %}Modifier l'application{% endblock %}

{% block body %}
<div class=" space-y-6">

    {# En-tête #}
    <div>
        <a
            href="{{ path('app_application_show', {id: application.id}) }}"
            class="inline-flex items-center gap-2 text-sm text-gray-500 transition hover:text-gray-950"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                <path d="m15 18-6-6 6-6"/>
                <path d="M9 12h11"/>
            </svg>
            Retour aux détails
        </a>

        <div class="mt-5">
            <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-gray-700">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" class="h-5 w-5" aria-hidden="true">
                        <path d="m14 6 4 4M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16l-1 4Z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-semibold tracking-tight text-gray-950">
                        Modifier l'application
                    </h1>
                    <p class="mt-1 text-sm text-gray-500">
                        Modifiez les informations de {{ application.name }}.
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# Messages d'erreur #}
    {% for message in app.flashes('error') %}
        <div role="alert" class="flex gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 8v5M12 16h.01"/>
            </svg>
            <p>{{ message }}</p>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">

        {# Formulaire principal #}
        <section class="overflow-hidden rounded-xl border border-gray-200 bg-white">
            <div class="border-b border-gray-200 px-5 py-4 sm:px-6">
                <h2 class="text-sm font-semibold text-gray-950">
                    Informations générales
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Les champs marqués d'un astérisque sont obligatoires.
                </p>
            </div>

            <form
                method="post"
                action="{{ path('app_application_edit', {id: application.id}) }}"
            >
                <div class="space-y-5 px-5 py-6 sm:px-6">

                    {# Nom #}
                    <div>
                        <label for="name" class="mb-2 block text-sm font-medium text-gray-800">
                            Nom de l'application <span class="text-gray-500">*</span>
                        </label>
                        <input
                            id="name"
                            name="name"
                            type="text"
                            maxlength="255"
                            required
                            autocomplete="organization-title"
                            value="{{ application.name }}"
                            placeholder="Ex. : DeployTrack API"
                            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-3.5 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-400 focus:ring-2 focus:ring-gray-100"
                        >
                        <p class="mt-2 text-xs text-gray-500">
                            Le nom utilisé pour identifier cette application dans votre espace.
                        </p>
                    </div>

                    {# URL du dépôt #}
                    <div>
                        <label for="repositoryUrl" class="mb-2 block text-sm font-medium text-gray-800">
                            URL du dépôt Git
                        </label>
                        <div class="relative">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7"
                                 class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400"
                                 aria-hidden="true">
                                <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19.05 4.7 5.07 5.07 0 0 0 18.96 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.04 1 4.04 1a5.07 5.07 0 0 0-.09 3.7A5.44 5.44 0 0 0 2.5 8.52c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22"/>
                            </svg>
                            <input
                                id="repositoryUrl"
                                name="repositoryUrl"
                                type="url"
                                maxlength="255"
                                value="{{ application.repositoryUrl ?? '' }}"
                                placeholder="https://github.com/organisation/projet"
                                class="h-11 w-full rounded-lg border border-gray-200 bg-white pl-10 pr-3.5 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-400 focus:ring-2 focus:ring-gray-100"
                            >
                        </div>
                        <p class="mt-2 text-xs text-gray-500">
                            Lien vers le dépôt GitHub, GitLab ou un autre hébergeur Git.
                        </p>
                    </div>

                    {# Description #}
                    <div>
                        <label for="description" class="mb-2 block text-sm font-medium text-gray-800">
                            Description
                        </label>
                        <textarea
                            id="description"
                            name="description"
                            rows="5"
                            placeholder="Décrivez brièvement le rôle de cette application..."
                            class="w-full resize-y rounded-lg border border-gray-200 bg-white px-3.5 py-3 text-sm leading-6 text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-400 focus:ring-2 focus:ring-gray-100"
                        >{{ application.description ?? '' }}</textarea>
                        <p class="mt-2 text-xs text-gray-500">
                            Présentez l'objectif ou les principales fonctionnalités du projet.
                        </p>
                    </div>
                </div>

                {# Actions #}
                <div class="flex flex-col-reverse gap-3 border-t border-gray-200 bg-gray-50/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-end sm:px-6">
                    <a
                        href="{{ path('app_application_show', {id: application.id}) }}"
                        class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 transition hover:bg-gray-50 hover:text-gray-950"
                    >
                        Annuler
                    </a>

                    <button
                        type="submit"
                        class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-gray-950 px-4 text-sm font-medium text-white transition hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
                    >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                            <path d="M5 3h12l4 4v14H3V3h2Z"/>
                            <path d="M7 3v6h10V3M7 21v-7h10v7"/>
                        </svg>
                        Enregistrer les modifications
                    </button>
                </div>
            </form>
        </section>

        {# Panneau latéral #}
        <aside class="space-y-4">

            <section class="rounded-xl border border-gray-200 bg-white p-5">
                <div class="flex items-center gap-2">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" class="h-4 w-4 text-gray-500" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M12 11v5M12 8h.01"/>
                    </svg>
                    <h2 class="text-sm font-semibold text-gray-950">
                        À propos
                    </h2>
                </div>

                <p class="mt-3 text-sm leading-6 text-gray-500">
                    Les modifications seront appliquées aux informations enregistrées
                    de cette application.
                </p>
            </section>

            <section class="rounded-xl border border-gray-200 bg-white p-5">
                <h2 class="text-sm font-semibold text-gray-950">
                    Détails de l'application
                </h2>

                <dl class="mt-4 space-y-4">
                    <div>
                        <dt class="text-xs text-gray-500">Identifiant</dt>
                        <dd class="mt-1 font-mono text-sm text-gray-900">
                            #{{ application.id }}
                        </dd>
                    </div>

                    <div>
                        <dt class="text-xs text-gray-500">Créée le</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {{ application.createdAt|date('d/m/Y') }}
                        </dd>
                    </div>

                    <div>
                        <dt class="text-xs text-gray-500">Dépôt Git</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {% if application.repositoryUrl %}
                                <span class="inline-flex items-center gap-2">
                                    <span class="h-2 w-2 rounded-full bg-gray-900"></span>
                                    Renseigné
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-2 text-gray-500">
                                    <span class="h-2 w-2 rounded-full bg-gray-300"></span>
                                    Non renseigné
                                </span>
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            </section>

            <a
                href="{{ path('app_application_show', {id: application.id}) }}"
                class="flex items-center justify-between rounded-xl border border-gray-200 bg-white p-4 text-sm transition hover:bg-gray-50"
            >
                <span class="font-medium text-gray-800">Consulter les détails</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" class="h-4 w-4 text-gray-400" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6"/>
                </svg>
            </a>
        </aside>
    </div>
</div>
{% endblock %}
