
{% extends 'base.html.twig' %}

{% block title %}Environnements - {{ application.name }}{% endblock %}

{% block body %}
    <h1>Environnements de {{ application.name }}</h1>

    <p>
        <a href="{{ path('app_application_show', {id: application.id}) }}">
            Retour à l'application
        </a>
    </p>

    <p>
        <a href="{{ path('app_environment_new', {applicationId: application.id}) }}">
            Ajouter un environnement
        </a>
    </p>

    {% for message in app.flashes('success') %}
        <p>{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <p>{{ message }}</p>
    {% endfor %}

    <h2>Liste des environnements</h2>

    {% if environments is empty %}
        <p>Aucun environnement enregistré pour cette application.</p>
    {% else %}
        <table border="1" cellpadding="8">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Type</th>
                    <th>URL</th>
                    <th>Date de création</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for environment in environments %}
                    <tr>
                        <td>{{ environment.name }}</td>
                        <td>{{ environment.type }}</td>
                        <td>
                            {% if environment.url %}
                                <a href="{{ environment.url }}" target="_blank" rel="noopener noreferrer">
                                    {{ environment.url }}
                                </a>
                            {% else %}
                                Non renseignée
                            {% endif %}
                        </td>
                        <td>{{ environment.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            <a href="{{ path('app_environment_show', {
                                applicationId: application.id,
                                id: environment.id
                            }) }}">
                                Voir
                            </a>

                            <a href="{{ path('app_environment_edit', {
                                applicationId: application.id,
                                id: environment.id
                            }) }}">
                                Modifier
                            </a>

                            <form
                                method="post"
                                action="{{ path('app_environment_delete', {
                                    applicationId: application.id,
                                    id: environment.id
                                }) }}"
                                onsubmit="return confirm('Voulez-vous vraiment supprimer cet environnement ?');"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete_environment_' ~ environment.id) }}"
                                >

                                <button type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
